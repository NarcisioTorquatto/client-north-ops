{
  "name": "north-ops-client",
  "version": "0.1.32",
  "private": true,
  "author": "North Ops Cliente",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron electron/main.cjs",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "electron-updater": "^6.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.0",
    "cross-env": "^10.1.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },


"build": {
  "appId": "com.northops.client",
  "productName": "NORTH OPS Client",

  "directories": {
    "output": "release"
  },

  "icon": "resources/icon.ico",

  "win": {
    "target": "nsis",
    "icon": "resources/icon.ico"
  },

  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],


"extraResources": [
  {
    "from": "resources/bridge",
    "to": "bridge"
  }
    
  ],
  
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NORTH OPS Client"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "NarcisioTorquatto",
      "repo": "client-north-ops",
      "releaseType": "release"
    }
  ]  
}


}